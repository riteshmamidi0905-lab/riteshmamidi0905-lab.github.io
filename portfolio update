.burger.x span:nth-child(2){opacity:0}
.burger.x span:nth-child(3){transform:translateY(-5.6px) rotate(-45deg)}
#bar{position:fixed;top:0;left:0;height:2px;width:0;background:var(--ac);z-index:101;transition:width .1s linear}

/* ---- HERO ---- */
#hero{min-height:100vh;display:flex;align-items:center;position:relative;padding:110px 0 90px;background:radial-gradient(1200px 720px at 72% -10%,rgba(34,211,166,.10),transparent 62%),radial-gradient(900px 700px at 4% 20%,rgba(120,140,170,.05),transparent 60%),var(--ink)}
#field{position:absolute;inset:0;width:100%;height:100%;z-index:0;opacity:.85}
.hgrid{position:absolute;inset:0;z-index:0;background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:70px 70px;-webkit-mask-image:radial-gradient(circle at 50% 32%,#000,transparent 78%);mask-image:radial-gradient(circle at 50% 32%,#000,transparent 78%)}
#hero .wrap{position:relative;z-index:2;max-width:1200px}
.hero-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:clamp(34px,5vw,72px);align-items:center}
.hero-copy{min-width:0}
.hero-avatar{position:relative;justify-self:end;width:min(31vw,380px);aspect-ratio:4/5;display:grid;place-items:end center}
.hero-avatar::before{content:"";position:absolute;inset:7% -8% -3% 8%;border-radius:48% 48% 28% 28%;background:radial-gradient(circle at 50% 42%,rgba(34,211,166,.18),rgba(34,211,166,.05) 48%,transparent 72%);filter:blur(4px)}
.hero-avatar::after{content:"";position:absolute;left:7%;right:7%;bottom:-2%;height:1px;background:linear-gradient(90deg,transparent,var(--ac),transparent);box-shadow:0 0 24px rgba(34,211,166,.55)}
.hero-avatar img{position:relative;z-index:1;width:100%;height:100%;object-fit:cover;object-position:center top;border-radius:32px 32px 24px 24px;border:1px solid rgba(255,255,255,.13);box-shadow:0 28px 80px rgba(0,0,0,.5),0 0 0 1px rgba(34,211,166,.08);-webkit-mask-image:linear-gradient(#000 0%,#000 82%,transparent 100%);mask-image:linear-gradient(#000 0%,#000 82%,transparent 100%)}
.hero-avatar .avatar-tag{position:absolute;z-index:2;right:-4px;bottom:8%;font-family:var(--mono);font-size:11px;color:#cfeee6;background:rgba(7,8,10,.76);border:1px solid rgba(34,211,166,.28);backdrop-filter:blur(12px);padding:8px 11px;border-radius:100px;white-space:nowrap}
.avail{display:inline-flex;align-items:center;gap:9px;font-family:var(--mono);font-size:12.5px;color:#c4cbd6;border:1px solid var(--line2);background:rgba(255,255,255,.04);padding:8px 15px;border-radius:100px}
.avail .dot{width:7px;height:7px;border-radius:50%;background:var(--ac);box-shadow:0 0 0 0 rgba(34,211,166,.55);animation:pulse 2.4s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(34,211,166,.5)}70%{box-shadow:0 0 0 8px rgba(34,211,166,0)}100%{box-shadow:0 0 0 0 rgba(34,211,166,0)}}
.hname{font-family:var(--mono);font-size:14px;letter-spacing:.34em;color:var(--mut);margin:28px 0 14px;text-transform:uppercase}
h1.big{font-size:clamp(46px,6.6vw,88px);font-weight:800;letter-spacing:-.045em;line-height:.97}
h1.big .l2{display:block;color:var(--mut)}
h1.big .l2 em{font-style:normal;color:#fff}
.hrole{font-size:clamp(17px,2.3vw,25px);color:#c3cad6;margin-top:26px;font-weight:450;min-height:1.3em}
.hrole .sep{color:var(--ac-x);margin:0 6px}
.hrole.typing{border-right:2px solid var(--ac);padding-right:2px}
.hrole.blink{animation:caret .8s steps(1) infinite}
@keyframes caret{50%{border-color:transparent}}
.hcta{display:flex;gap:13px;flex-wrap:wrap;margin-top:38px}
.btn{display:inline-flex;align-items:center;gap:9px;font-size:15.5px;font-weight:600;padding:13px 24px;border-radius:100px;transition:transform .22s cubic-bezier(.2,.7,.2,1),background .22s,box-shadow .22s,color .2s;border:1px solid transparent;cursor:pointer}
.btn svg{transition:transform .22s}
.btn-p{background:var(--ac);color:#04150f;box-shadow:0 8px 30px rgba(34,211,166,.24)}
.btn-p:hover{transform:translateY(-2px);box-shadow:0 14px 40px rgba(34,211,166,.34)}
.btn-p:hover svg{transform:translateX(4px)}
.btn-o{background:transparent;color:#eef2f6;border-color:var(--line2)}
.btn-o:hover{background:rgba(255,255,255,.06);transform:translateY(-2px)}
.paper .btn-o{color:#0e1013;border-color:rgba(0,0,0,.18)}
.paper .btn-o:hover{background:rgba(0,0,0,.05)}
.hmeta{display:flex;gap:34px;flex-wrap:wrap;margin-top:52px}
.hmeta .m .v{font-family:var(--mono);font-size:clamp(26px,3.4vw,40px);font-weight:600;letter-spacing:-.02em;color:#fff;line-height:1}
.hmeta .m .k{font-size:12.5px;color:#7f8797;margin-top:8px}
.scue{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);z-index:2;font-family:var(--mono);font-size:10px;letter-spacing:.3em;color:#5c6474;display:flex;flex-direction:column;align-items:center;gap:8px}
.scue .m{width:20px;height:32px;border:1.4px solid rgba(255,255,255,.2);border-radius:11px;position:relative}
.scue .m::after{content:"";position:absolute;top:6px;left:50%;transform:translateX(-50%);width:2.5px;height:6px;border-radius:2px;background:var(--ac);animation:sd 1.7s ease-in-out infinite}
@keyframes sd{0%{opacity:0;transform:translate(-50%,0)}30%{opacity:1}70%{opacity:1}100%{opacity:0;transform:translate(-50%,11px)}}

/* ---- REVEAL / MOTION ---- */
/* content is visible by default; .in plays a one-shot entrance animation.
   if JS never adds .in (disabled/failed), everything simply stays visible. */
.rv.in{animation:rvin .8s cubic-bezier(.16,.8,.24,1) both}
@keyframes rvin{from{opacity:0;transform:translateY(34px)}to{opacity:1;transform:none}}
.rv.d1{animation-delay:.07s}.rv.d2{animation-delay:.14s}.rv.d3{animation-delay:.21s}.rv.d4{animation-delay:.28s}
.hero-rise{opacity:0;transform:translateY(26px);animation:rise .9s cubic-bezier(.16,.8,.24,1) forwards}
@keyframes rise{to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.rv,.hero-rise{opacity:1!important;transform:none!important;transition:none!important;animation:none!important}
  #field{display:none}.avail .dot{animation:none}.scue{display:none}*{scroll-behavior:auto!important}}

/* ---- THE SYSTEM ---- */
#system{background:var(--ink);overflow:hidden}
.sys-head{text-align:center;max-width:760px;margin:0 auto}
.sys-flow{margin-top:64px;position:relative;max-width:900px;margin-left:auto;margin-right:auto}
.sys-line{position:absolute;left:31px;top:14px;bottom:14px;width:2px;background:rgba(255,255,255,.08);overflow:hidden}
.sys-line .fill{position:absolute;left:0;top:0;width:100%;height:0;background:linear-gradient(180deg,var(--ac),rgba(34,211,166,.2));box-shadow:0 0 14px rgba(34,211,166,.6);transition:height .15s linear}
.stage{position:relative;padding-left:78px;padding-bottom:40px;opacity:.4;transition:opacity .5s}
.stage:last-child{padding-bottom:0}
.stage.on{opacity:1}
.stage .node{position:absolute;left:16px;top:2px;width:34px;height:34px;border-radius:50%;background:var(--ink2);border:2px solid rgba(255,255,255,.14);display:grid;place-items:center;font-family:var(--mono);font-size:12px;font-weight:600;color:var(--mut);transition:.5s;z-index:2}
.stage.on .node{border-color:var(--ac);color:var(--ac);box-shadow:0 0 0 5px rgba(34,211,166,.1),0 0 18px rgba(34,211,166,.4)}
.stage h3{font-size:clamp(22px,3vw,32px);font-weight:700;letter-spacing:-.02em;transition:color .4s}
.stage .desc{color:var(--mut);font-size:15px;margin-top:5px;max-width:520px}
.stage .techs{margin-top:12px;font-family:var(--mono);font-size:12.5px;color:var(--dim)}
.stage .techs span{transition:color .4s}
.stage .techs span:not(:last-child)::after{content:"  ·  ";opacity:.5}
.stage.on .techs span{color:#aeb6c4}

/* ---- SELECTED WORK / FLAGSHIPS ---- */
.flagw{border-top:1px solid var(--line);padding:clamp(48px,7vh,86px) 0}
.flag{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,5vw,72px);align-items:center}
.flag.rev .flag-txt{order:2}
.flag-num{font-family:var(--mono);font-size:14px;color:var(--ac-x);font-weight:600}
.flag h3{font-size:clamp(26px,3.4vw,42px);font-weight:700;letter-spacing:-.025em;line-height:1.08;margin:12px 0 0}
.flag .one{font-size:clamp(17px,1.9vw,20px);color:var(--mut);margin-top:16px;line-height:1.5}
.flag .impact{display:inline-flex;align-items:center;gap:9px;margin-top:18px;font-size:14px;color:var(--tx);font-weight:550}
.flag .impact b{color:var(--ac-x)}
.flag .fstack{font-family:var(--mono);font-size:12.5px;letter-spacing:.01em;color:var(--dim);margin-top:20px}
.flag .flinks{display:flex;gap:18px;align-items:center;margin-top:24px;flex-wrap:wrap}
.flag .flinks a{font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:6px;transition:.2s}
.flag .flinks a svg{transition:transform .2s}
.flag .flinks a:hover svg{transform:translateX(3px)}
.flag .flinks .cs{color:var(--tx);border-bottom:1px solid transparent}
.flag .flinks .cs:hover{border-color:var(--ac-x)}
.flag .flinks .gh{color:var(--ac-x)}
.flag .flinks .dm{color:var(--tx)}
.flag-visual{position:relative;border-radius:22px;overflow:hidden;border:1px solid var(--line);background:linear-gradient(160deg,var(--card),var(--bg2));aspect-ratio:4/3;display:grid;place-items:center;transition:transform .4s cubic-bezier(.2,.7,.2,1),border-color .4s}
.flag-visual:hover{transform:scale(1.015);border-color:var(--line2)}
.flag-visual svg{width:86%;height:auto;overflow:visible}
/* case study */
.cs-panel{margin-top:6px}
.cs-summary{list-style:none;cursor:pointer;display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:var(--tx);padding:14px 0 2px;user-select:none;transition:color .2s}
.cs-summary::-webkit-details-marker{display:none}
.cs-summary::marker{content:""}
.cs-summary:hover{color:var(--ac-x)}
.cs-summary .caret{transition:transform .3s}
details[open] .cs-summary .caret{transform:rotate(180deg)}
.cs-inner{padding:14px 0 6px;display:grid;grid-template-columns:repeat(2,1fr);gap:22px 40px}
.pcard.hide{display:none}
.cs-block h4{font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ac-x);margin-bottom:7px}
.cs-block p{font-size:14.5px;color:var(--mut);line-height:1.58}
.cs-block.arch{grid-column:1/-1}
.cs-arch{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:6px}
.cs-arch .b{font-family:var(--mono);font-size:12.5px;padding:8px 13px;border-radius:9px;background:var(--card);border:1px solid var(--line2);color:var(--tx);white-space:nowrap}
.cs-arch .ar{color:var(--ac-x);font-weight:700}

/* more work grid */
.mw-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-top:96px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:26px}
.fbtn{font-family:var(--sf);font-size:13.5px;font-weight:500;padding:8px 16px;border-radius:100px;border:1px solid var(--line2);background:transparent;color:var(--mut);cursor:pointer;transition:.2s}
.fbtn:hover{color:var(--tx);border-color:var(--tx)}
.fbtn.on{background:var(--ac);color:#04150f;border-color:transparent;font-weight:600}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:26px}
.pcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;display:flex;flex-direction:column;transition:transform .25s,border-color .25s;position:relative}
.pcard:hover{transform:translateY(-4px);border-color:var(--line2)}
.pcard .cat{font-family:var(--mono);font-size:10.5px;font-weight:600;color:var(--ac-x);text-transform:uppercase;letter-spacing:.06em}
.pcard h4{font-size:16px;font-weight:700;margin:9px 0 7px;letter-spacing:-.01em;line-height:1.25}
.pcard p{font-size:13px;color:var(--mut);line-height:1.5;flex:1}
.pcard .tt{display:flex;flex-wrap:wrap;gap:5px;margin:13px 0}
.pcard .tt span{font-family:var(--mono);font-size:10px;padding:3px 8px;border-radius:6px;background:var(--bg2);border:1px solid var(--line);color:var(--dim)}
.pcard .links{display:flex;gap:13px;margin-top:2px}
.pcard .links a{font-size:12.5px;font-weight:600;display:inline-flex;gap:4px;align-items:center}
.pcard .links .code{color:var(--ac-x)}
.pcard .links .demo{color:var(--tx)}
.pcard .links a:hover{text-decoration:underline}

/* ---- CAPABILITIES ---- */
.cap-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:56px}
.cap{border:1px solid var(--line);border-radius:20px;padding:32px;background:var(--card);transition:border-color .3s}
.cap:hover{border-color:var(--line2)}
.cap .cn{font-family:var(--mono);font-size:13px;color:var(--ac-x);font-weight:600}
.cap h3{font-size:21px;font-weight:700;letter-spacing:-.015em;margin:8px 0 16px}
.cap ul{list-style:none;display:flex;flex-wrap:wrap;gap:8px}
.cap li{font-family:var(--mono);font-size:12.5px;padding:6px 12px;border-radius:100px;background:var(--bg2);border:1px solid var(--line);color:var(--mut)}

/* ---- IMPACT ---- */
#impact{background:var(--ink2)}
.imp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:56px}
.imp{text-align:left;border-left:2px solid var(--line2);padding:6px 0 6px 22px}
.imp .n{font-family:var(--mono);font-size:clamp(38px,5vw,58px);font-weight:600;letter-spacing:-.03em;line-height:1;color:#fff}
.imp .n .u{color:var(--ac-x)}
.imp .l{font-size:14px;color:var(--mut);margin-top:12px;line-height:1.4}
.imp-note{font-size:12.5px;color:var(--dim);margin-top:26px;font-family:var(--mono)}

/* ---- EXPERIENCE ---- */
.tl{margin-top:56px;position:relative}
.tl::before{content:"";position:absolute;left:7px;top:10px;bottom:10px;width:2px;background:linear-gradient(180deg,var(--ac),rgba(34,211,166,.15))}
.job{position:relative;padding-left:40px;margin-bottom:38px}
.job:last-child{margin-bottom:0}
.job::before{content:"";position:absolute;left:0;top:6px;width:16px;height:16px;border-radius:50%;background:var(--bg);border:3px solid var(--line2)}
.job.cur::before{border-color:var(--ac);box-shadow:0 0 0 4px rgba(34,211,166,.15)}
.job.cur{padding:26px 26px 26px 40px;margin-left:-26px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(160deg,rgba(34,211,166,.05),transparent)}
.job.cur::before{left:26px}
.job .top{display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap}
.job h3{font-size:19px;font-weight:700;letter-spacing:-.02em}
.job .badge{font-family:var(--mono);font-size:10.5px;color:var(--ac-x);border:1px solid var(--ac-x);border-radius:100px;padding:3px 9px;margin-left:10px;vertical-align:middle}
.job .when{font-family:var(--mono);font-size:12.5px;color:var(--mut);white-space:nowrap}
.job .org{font-size:14px;color:var(--mut);margin:5px 0 12px}
.job ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.job li{position:relative;padding-left:18px;font-size:14.5px;color:var(--mut);line-height:1.55}
.job li::before{content:"";position:absolute;left:0;top:9px;width:5px;height:5px;border-radius:50%;background:var(--ac-x)}
.job li b{color:var(--tx);font-weight:600}

/* ---- ABOUT ---- */
.ab-grid{display:grid;grid-template-columns:.9fr 1.3fr;gap:clamp(28px,4vw,56px);align-items:center;margin-top:56px}
.ab-card{border:1px solid var(--line);border-radius:22px;padding:34px;background:var(--card);text-align:center}
.avatar{width:132px;height:132px;border-radius:50%;padding:3px;background:var(--ac);margin:0 auto;box-shadow:0 14px 44px rgba(34,211,166,.24)}
.avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover}
.ab-card .pn{font-size:22px;font-weight:700;letter-spacing:-.02em;margin-top:16px}
.ab-card .pr{font-size:13.5px;color:var(--mut);margin-top:4px}
.ab-card .quick{display:flex;flex-direction:column;gap:0;margin-top:20px;text-align:left}
.ab-card .quick .q{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);font-size:13.5px}
.ab-card .quick .q .k{color:var(--dim)}
.ab-card .quick .q .v{color:var(--tx);font-weight:550;text-align:right}
.ab-txt .ab-lead{font-size:clamp(21px,2.6vw,30px);font-weight:600;letter-spacing:-.02em;line-height:1.25}
.ab-txt p{color:var(--mut);font-size:16px;line-height:1.62;margin-top:18px}
.ab-txt p b{color:var(--tx);font-weight:600}

/* ---- EDUCATION ---- */
.edu-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:52px}
.edu{border:1px solid var(--line);border-radius:20px;padding:30px;background:var(--card)}
.edu h4.ttl{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--ac-x);margin-bottom:16px}
.edu .li{display:flex;gap:14px;padding:13px 0;border-top:1px solid var(--line)}
.edu .li:first-of-type{border-top:0}
.edu .li .ic{font-size:18px;width:36px;height:36px;border-radius:10px;background:var(--bg2);display:grid;place-items:center;flex-shrink:0;border:1px solid var(--line)}
.edu .li h5{font-size:15px;font-weight:700;letter-spacing:-.01em}
.edu .li .s{font-size:12.5px;color:var(--mut);margin-top:3px;line-height:1.4}
.edu .li a{font-size:12px;color:var(--ac-x);font-weight:600;margin-top:5px;display:inline-flex;gap:4px}
.edu .li a:hover{text-decoration:underline}

/* ---- CONTACT ---- */
#contact{text-align:center;background:radial-gradient(900px 560px at 50% 8%,rgba(34,211,166,.12),transparent 60%),var(--ink)}
#contact .big{font-size:clamp(44px,8vw,110px);font-weight:800;letter-spacing:-.045em;line-height:.98}
#contact .big .mut{color:var(--mut);display:block}
#contact p{font-size:19px;color:var(--mut);margin:26px auto 0;max-width:560px}
.copymail{display:inline-flex;align-items:center;gap:12px;margin-top:34px;font-family:var(--mono);font-size:clamp(15px,2vw,20px);color:#fff;border:1px solid var(--line2);background:rgba(255,255,255,.03);padding:14px 22px;border-radius:100px;cursor:pointer;transition:.2s;max-width:100%}
.copymail:hover{border-color:var(--ac);background:rgba(34,211,166,.06)}
.copymail .ico{color:var(--ac-x);display:inline-flex}
.copymail .cp{font-size:11px;color:var(--dim);border-left:1px solid var(--line2);padding-left:12px}
.copymail.ok .cp{color:var(--ac-x)}
.csoc{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:26px}

/* ---- FOOTER ---- */
footer{background:#050608;border-top:1px solid rgba(255,255,255,.07);padding:38px 0;color:#6a7280;font-size:13px}
footer .wrap{display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap}
footer .fl{display:flex;gap:20px}
footer a{color:#98a0ad;font-weight:500;transition:.2s}
footer a:hover{color:#fff}
.tocopy-toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--ac);color:#04150f;font-weight:600;font-size:13.5px;padding:10px 20px;border-radius:100px;opacity:0;transition:.3s;z-index:200;pointer-events:none}
.tocopy-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* focus */
a:focus-visible,button:focus-visible{outline:2px solid var(--ac);outline-offset:3px;border-radius:6px}

/* ---- RESPONSIVE ---- */
@media(max-width:920px){
  .hero-layout{grid-template-columns:1fr}
  .hero-avatar{justify-self:start;width:min(68vw,360px);margin-top:12px}
  .hero-avatar .avatar-tag{right:0}
  .flag{grid-template-columns:1fr;gap:26px}
  .flag.rev .flag-txt{order:0}
  .flag-visual{order:-1;aspect-ratio:16/10}
  .cs-inner{grid-template-columns:1fr}
  .ab-grid{grid-template-columns:1fr}
  .cap-grid{grid-template-columns:1fr}
  .imp-grid{grid-template-columns:repeat(2,1fr)}
  .pgrid{grid-template-columns:repeat(2,1fr)}
  .edu-grid{grid-template-columns:1fr}
}
@media(max-width:480px){
  .copymail{font-size:13.5px;padding:12px 16px;gap:9px}
  .copymail .cp{display:none}
}
@media(max-width:640px){
